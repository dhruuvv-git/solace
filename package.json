{
  "name": "solace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs --production",
    "lint": "oxlint src server scripts",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --test server/app.test.mjs",
    "test:web": "node scripts/e2e-journey.mjs",
    "extension:install": "npm --prefix extension install",
    "extension:build": "npm --prefix extension run package && node scripts/copy-extension.mjs",
    "extension:test": "npm --prefix extension test"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "vgpu": "^0.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
